SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SHOP_ORIGIN=https://your-store.example
TURNSTILE_SECRET_KEY=
# Enable only after stock, shipping and bank-transfer flow have been tested.
BANK_CHECKOUT_ENABLED=false
# Optional legacy gateway configuration; not used for new bank-transfer orders.
TOYYIBPAY_ENV=sandbox
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# Optional Gmail sending: use a Google App Password, never the login password.
EMAIL_ENABLED=false
GMAIL_APP_PASSWORD=

# Merchant receiving details. Set these privately in Vercel.
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
